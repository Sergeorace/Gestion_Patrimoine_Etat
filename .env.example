# =============================================================================
# Configuration racine - Plateforme de gestion du patrimoine de l'Etat togolais
# Copier en .env puis executer : ./tools/init_env.sh
# =============================================================================

# --- Ports de la passerelle (cotes hotes) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL (instance unique, une base logique par service) ---
DB_USER=patrimoine
DB_PASSWORD=changez-moi-mot-de-passe-fort

# --- RabbitMQ ---
RABBITMQ_USER=patrimoine
RABBITMQ_PASSWORD=changez-moi-mot-de-passe-fort
